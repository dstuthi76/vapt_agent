# Copy to .env and edit.  Never commit .env.

# ---- AI reasoning engine: none | anthropic | openai | ollama ----
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Ollama on the host machine (from inside Docker use http://host.docker.internal:11434)
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# ---- tools ----
ZAP_URL=http://localhost:8090
ZAP_API_KEY=vapt-lab-zap-key
# Metasploit validation (set MSF_RPC_HOST=msf when using the docker 'validation' profile)
MSF_RPC_HOST=
MSF_RPC_PASS=vapt-lab-msf-pass
# Experimental OpenVAS live mode (path to gvmd socket)
GVM_SOCKET=

# ---- behaviour ----
VAPT_SCOPE_FILE=config/scope.lab.json
VAPT_JOB_TIMEOUT=900
VAPT_AUTO_APPROVE_FOLLOWUPS=true
VAPT_MAX_ACTIONS=40
# Optional: require header X-API-Token on /api/* (the console does not send it; use for API-only setups)
VAPT_API_TOKEN=
